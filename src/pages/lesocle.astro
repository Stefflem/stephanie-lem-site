---
/** Le Socle. Copy dans src/content/vente/lesocle.md, modifiable par Stéphanie. */
import Vente from '../layouts/Vente.astro';
import VenteCorps from '../components/VenteCorps.astro';
import { getEntry } from 'astro:content';
import { VENTE } from '../site';
const page = await getEntry('vente', 'lesocle');
if (!page) throw new Error('Contenu lesocle manquant');
const d = page.data;
const lienAchat = VENTE.socleLienPaiement || '#inscription';
const libelleBouton = `${d.bouton} – ${VENTE.soclePrix}${VENTE.soclePrixBarre ? ` au lieu de ${VENTE.soclePrixBarre}` : ''} !`;
---
<Vente title={`${d.surtitre} · ${d.titre} | Stellaé Experiences`} description={d.seo_description} image={d.banniere}>
  {d.banniere && <div class="v-banniere"><img src={d.banniere} alt={d.titre} width="1366" height="768" fetchpriority="high"></div>}
  <section class="v-wrap v-hero">
    <p class="v-eyebrow">{d.surtitre}</p>
    <h1>{d.titre}</h1>
    <p class="v-sur">{d.accroche}</p>
    {d.sous_titres.map((s) => <p class="v-sous">{s}</p>)}
    <div class="v-cta-bloc">
      <a class="v-cta" href={lienAchat}>{libelleBouton}</a>
      <p class="v-rassure">{d.rassurance}</p>
    </div>
  </section>

  <div class="v-wrap">
    <div class="v-recois">
      <h2>{d.recois_titre}</h2>
      <ul>{d.recois.map((r) => <li>{r}</li>)}</ul>
    </div>

    {VENTE.socleFinPromo && (
      <div class="v-compteur" data-fin={VENTE.socleFinPromo}>
        <span class="v-compteur-label">Le prix augmente dans :</span>
        <div class="v-compteur-val" data-compteur>—</div>
      </div>
    )}

    <VenteCorps body={page.body ?? ''} />

    {d.visuels.length > 0 && (
      <div class="v-visuels">
        {d.visuels.map((v) => (
          <figure><img src={v.image} alt={v.legende} loading="lazy"><figcaption>{v.legende}</figcaption></figure>
        ))}
      </div>
    )}

    <div class="v-prix">
      <p class="v-eyebrow">{d.prix_titre}</p>
      <div>
        <span class="v-prix-montant">{VENTE.soclePrix}</span>
        {VENTE.soclePrixBarre && <span class="v-prix-barre">{VENTE.soclePrixBarre}</span>}
      </div>
      {d.prix_mentions.map((m) => <p>{m}</p>)}
      <h3>{d.inclus_titre}</h3>
      <ul class="v-prix-liste">{d.inclus.map((i) => <li>{i}</li>)}</ul>
      <div class="v-cta-bloc">
        <a class="v-cta" href={lienAchat}>{d.bouton}</a>
        <p class="v-rassure">{d.final_rassurance}</p>
      </div>
    </div>

    <section class="v-sec v-faq">
      <h2>Questions fréquentes</h2>
      {d.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.r}</p></details>))}
    </section>

    <div class="v-prix" id="inscription">
      <h2>{d.final_titre}</h2>
      <p>{d.final_sous}</p>
      <div class="v-cta-bloc">
        {VENTE.socleLienPaiement
          ? <a class="v-cta" href={VENTE.socleLienPaiement}>{d.bouton}</a>
          : <a class="v-cta" href={`mailto:${VENTE.contact}?subject=Le%20Socle`}>Écrire à Stéphanie pour recevoir le lien</a>}
        <p class="v-rassure">{d.final_rassurance}</p>
      </div>
    </div>

    <section class="v-sec">
      <p>{d.contact_texte} <a href={`mailto:${VENTE.contact}`}>{VENTE.contact}</a></p>
    </section>
  </div>
  {VENTE.socleFinPromo && <script is:inline src="/js/compteur.js"></script>}
</Vente>
