---
/** Rend un bloc JSON LD. Les clés vides sont retirées : un schéma qui déclare
 *  un champ vide vaut moins que pas de champ du tout. */
interface Props { data: Record<string, unknown> }
const nettoie = (o: any): any => {
  if (Array.isArray(o)) return o.map(nettoie).filter((v) => v !== undefined);
  if (o && typeof o === 'object') {
    const r: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(o)) {
      const n = nettoie(v);
      if (n !== undefined && n !== '' && !(Array.isArray(n) && n.length === 0)) r[k] = n;
    }
    return Object.keys(r).length ? r : undefined;
  }
  return o;
};
const { data } = Astro.props;
const propre = nettoie(data);
---
{propre && <script type="application/ld+json" set:html={JSON.stringify(propre)} />}
