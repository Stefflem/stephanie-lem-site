---
/** Étude de cas en direct. Copy dans src/content/vente/etudenoelfinlande.md.
 *  ⚠️ noindex : la séance annoncée du 8 septembre 2026 est passée. */
import Vente from '../layouts/Vente.astro';
import VenteCorps from '../components/VenteCorps.astro';
import { getEntry } from 'astro:content';
import { VENTE } from '../site';
const page = await getEntry('vente', 'etudenoelfinlande');
if (!page) throw new Error('Contenu etudenoelfinlande manquant');
const d = page.data;
---
<Vente title={`${d.titre} | Stellaé Experiences`} description={d.seo_description} image={d.image} noindex={true}>
  {d.banniere && <div class="v-banniere"><img src={d.banniere} alt={d.titre} width="1500" height="844" fetchpriority="high"></div>}
  <section class="v-wrap v-hero">
    <p class="v-eyebrow">{d.surtitre}</p>
    <h1>{d.titre}</h1>
    <p class="v-sur">{d.accroche}</p>
    {d.sous_titres.map((s) => <p class="v-sous">{s}</p>)}
    <div class="v-cta-bloc">
      <a class="v-cta" href="#inscription">{d.bouton}</a>
      <p class="v-rassure">{d.rassurance}</p>
    </div>
  </section>

  <div class="v-wrap">
    <VenteCorps body={page.body ?? ''} />

    {d.programme.length > 0 && (
      <section class="v-sec v-faq">
        <h2>Le programme, jour par jour</h2>
        {d.programme.map((j) => (
          <details>
            <summary>{j.titre}</summary>
            {j.lignes.map((l) => <p>{l}</p>)}
          </details>
        ))}
      </section>
    )}

    <div class="v-form" id="inscription">
      <h2>{d.final_titre}</h2>
      <p>{d.final_sous}</p>
      <form name="webinaire" method="POST" action="/merci-webinaire/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="webinaire">
        <p class="hp"><label>Ne pas remplir <input name="bot-field"></label></p>
        <div class="field"><label for="prenom">Ton prénom</label><input id="prenom" name="prenom" type="text" required autocomplete="given-name"></div>
        <div class="field"><label for="email">Ton e-mail</label><input id="email" name="email" type="email" required autocomplete="email"></div>
        <button class="v-cta" type="submit">{d.final_rassurance}</button>
        <p class="note">Une question ? <a href={`mailto:${VENTE.contact}`}>{VENTE.contact}</a></p>
      </form>
    </div>
  </div>
</Vente>
