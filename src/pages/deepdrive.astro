---
/** Deep Drive 360. Copy dans src/content/vente/deepdrive.md. Réservation Calendly. */
import Vente from '../layouts/Vente.astro';
import PageEnPause from '../components/PageEnPause.astro';
import VenteCorps from '../components/VenteCorps.astro';
import { getEntry } from 'astro:content';
import { reglagesVente } from '../vente';
const VENTE = await reglagesVente();
const page = await getEntry('vente', 'deepdrive');
if (!page) throw new Error('Contenu deepdrive manquant');
const d = page.data;
const schema = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: d.surtitre, description: d.seo_description, serviceType: 'Séance de clarification',
  provider: { '@type': 'Organization', name: 'Stellaé Experiences', url: 'https://www.stephanielem.fr' },
  areaServed: 'FR', audience: { '@type': 'Audience', audienceType: 'Entrepreneuses et accompagnantes' },
  url: 'https://www.stephanielem.fr/deepdrive/',
  potentialAction: { '@type': 'ReserveAction', target: 'https://www.stephanielem.fr/deepdrive/' },
  offers: VENTE.deepdrivePrix
    ? { '@type': 'Offer', price: VENTE.deepdrivePrix.replace(/[^0-9,.]/g, '').replace(',', '.'),
        priceCurrency: 'EUR', availability: 'https://schema.org/InStock',
        url: VENTE.deepdriveLienPaiement || 'https://www.stephanielem.fr/deepdrive/' }
    : undefined,
};
/** Deep Drive se paie. L agenda ne s ouvre qu apres paiement verifie, via
 *  /acces/. Sans lien de paiement pose, on retombe sur l agenda direct pour
 *  ne pas laisser un bouton mort. */
const achat = VENTE.deepdriveLienPaiement || d.calendly;
const dehors = /^https?:\/\//.test(achat) && !achat.includes('stephanielem.fr');
const sortie = dehors ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<Vente title={`${d.surtitre} | Stellaé Experiences`} description={d.seo_description} image={d.banniere} titreExact={d.seo_titre || undefined} schema={schema} noindex={d.en_ligne === false}>
{d.en_ligne === false ? (
  <PageEnPause titre={d.titre} message={d.message_pause} banniere={d.banniere} />
) : (<>
  {d.banniere && <div class="v-banniere"><img src={d.banniere} alt={d.titre} width="1366" height="768" fetchpriority="high"></div>}
  <section class="v-wrap v-hero">
    <p class="v-eyebrow">{d.surtitre}</p>
    <h1>{d.titre}</h1>
    <p class="v-sur">{d.accroche}</p>
    {d.sous_titres.map((s) => <p class="v-sous">{s}</p>)}
    <div class="v-cta-bloc">
      <a class="v-cta" href="#reserver">{d.bouton}{VENTE.deepdrivePrix ? ` – ${VENTE.deepdrivePrix}` : ''}</a>
      <p class="v-rassure">{d.rassurance}</p>
    </div>
  </section>
  <div class="v-wrap">
    <VenteCorps body={page.body ?? ''} />
    <div class="v-prix" id="reserver">
      {VENTE.deepdrivePrix && <p class="v-eyebrow">{VENTE.deepdrivePrix}</p>}
      <h2>{d.final_titre}</h2>
      <p>{d.final_sous}</p>
      <div class="v-cta-bloc">
        <a class="v-cta" href={achat} {...sortie}>{d.bouton}</a>
        <p class="v-rassure">{d.final_rassurance}</p>
      </div>
      <p class="note">Une question avant de réserver ? <a href={`mailto:${VENTE.contact}`}>{VENTE.contact}</a></p>
      <p class="note">Pas encore prête pour deux heures ? Commence par le roman, <a href="/ysaline/">La traversée d'Ysaline</a>, qui se lit comme une expérience.</p>
    </div>
  </div>
</>)}
</Vente>
