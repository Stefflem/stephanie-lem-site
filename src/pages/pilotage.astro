---
/**
 * Le tableau de bord de Stéphanie.
 *
 * Accessible depuis son espace d'édition, et protégé par la même connexion :
 * la page lit le jeton GitHub que Decap a mis en mémoire et le transmet à la
 * fonction, qui vérifie auprès de GitHub que ce compte peut modifier le site.
 * Personne d'autre ne voit ses chiffres.
 *
 * En noindex, et hors du plan du site : ce n'est pas une page de son site.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { ADRESSES, NOMS } from '../offres';
import { reglagesVente } from '../vente';

const VENTE = await reglagesVente();
const ventes = await getCollection('vente');

/** L'état de ses offres est connu à la construction, pas besoin d'appel. */
const offres = ventes
  .map((v) => ({
    nom: NOMS[v.id] ?? v.data.titre,
    adresse: ADRESSES[v.id] ?? `/${v.id}/`,
    enLigne: v.data.en_ligne !== false,
    prix:
      v.id === 'lesocle' ? VENTE.soclePrix
      : v.id === 'ysaline' ? VENTE.ysalinePrix
      : v.id === 'deepdrive' ? VENTE.deepdrivePrix
      : v.id === 'guideoffert' || v.id === 'etudenoelfinlande' ? 'gratuit'
      : '',
    /* Le prix du Socle, d'Ysaline et de Deep Drive se change dans « Boutique »,
       tout le reste dans la page de vente elle même. */
    modifier: `/admin/#/collections/vente/entries/${v.id}`,
  }))
  .sort((a, b) => Number(b.enLigne) - Number(a.enLigne));
---
<Base
  title="Tableau de bord"
  titreExact="Tableau de bord | Stellaé Experiences"
  description="Les chiffres de Stéphanie."
  noindex={true}
>
  <header class="page-head">
    <p class="eyebrow">Ton activité</p>
    <h1>Tableau de bord</h1>
    <p class="head-lead" id="pil-maj">Chargement…</p>
  </header>

  <div class="reading pilotage">

    <p class="pil-souci" id="pil-souci" hidden></p>

    <div id="pil-contenu" hidden>
      <div class="pil-chiffres" id="pil-chiffres"></div>
      <div id="pil-etat"></div>

      <h2>Tes dernières ventes</h2>
      <div id="pil-ventes"></div>

      <h2>Les personnes qui te suivent</h2>
      <div id="pil-inscrits"></div>
    </div>

    <h2>Tes offres</h2>
    <table class="pil-table">
      <thead><tr><th>Offre</th><th>Prix</th><th>État</th><th></th></tr></thead>
      <tbody>
        {offres.map((o) => (
          <tr>
            <td><a href={o.adresse}>{o.nom}</a></td>
            <td>{o.prix || '—'}</td>
            <td>
              {o.enLigne
                ? <span class="pil-pastille pil-ok">en ligne</span>
                : <span class="pil-pastille pil-pause">en pause</span>}
            </td>
            <td><a class="pil-modifier" href={o.modifier}>Modifier</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="aide-note">
      Pour mettre une offre en pause, clique sur <strong>Modifier</strong> et décoche{' '}<strong>Page en ligne</strong>. Le prix du Socle, d'Ysaline et de Deep Drive se change
      dans <a href="/admin/#/collections/boutique/entries/vente">Boutique et livraison</a>.
    </p>

    <h2>Tes raccourcis</h2>
    <div class="pil-raccourcis">
      <a href="/admin/"><strong>Modifier mon site</strong><span>textes, photos, articles, offres</span></a>
      <a href="https://dashboard.stripe.com/payments" target="_blank" rel="noopener"><strong>Stripe</strong><span>tes paiements, tes remboursements</span></a>
      <a href="https://app.brevo.com/contact/list" target="_blank" rel="noopener"><strong>Brevo</strong><span>tes contacts, tes e-mails</span></a>
      <a href="https://app.cal.com/bookings/upcoming" target="_blank" rel="noopener"><strong>Cal.com</strong><span>tes rendez-vous à venir</span></a>
      <a href="/aide/"><strong>Mode d'emploi</strong><span>comment tout faire, pas à pas</span></a>
    </div>
  </div>
  <script is:inline src="/js/pilotage.js"></script>
</Base>
