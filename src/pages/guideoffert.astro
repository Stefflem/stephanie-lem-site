---
/** Déclic Immersif. Copy dans src/content/vente/guideoffert.md. */
import Vente from '../layouts/Vente.astro';
import VenteCorps from '../components/VenteCorps.astro';
import { getEntry } from 'astro:content';
import { VENTE } from '../site';
const page = await getEntry('vente', 'guideoffert');
if (!page) throw new Error('Contenu guideoffert manquant');
const d = page.data;
---
<Vente title={`${d.surtitre} | Stellaé Experiences`} description={d.seo_description} image={d.image}>
  <section class="v-wrap v-hero">
    <p class="v-eyebrow">{d.surtitre}</p>
    <h1>{d.titre}</h1>
    <p class="v-sur">{d.accroche}</p>
    {d.sous_titres.map((s) => <p class="v-sous">{s}</p>)}
    <div class="v-cta-bloc">
      <a class="v-cta" href="#inscription">{d.bouton}</a>
      <p class="v-rassure">{d.rassurance}</p>
    </div>
    {(d.banniere || d.image) && <img src={d.banniere || d.image} alt={d.titre} class="v-visuel" loading="lazy">}
  </section>

  <div class="v-wrap">
    <VenteCorps body={page.body ?? ''} />

    <div class="v-form" id="inscription">
      <h2>{d.final_titre}</h2>
      <p>{d.final_sous}</p>
      <form name="guide" method="POST" action="/merci-guide/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="guide">
        <p class="hp"><label>Ne pas remplir <input name="bot-field"></label></p>
        <div class="field"><label for="prenom">Ton prénom</label><input id="prenom" name="prenom" type="text" required autocomplete="given-name"></div>
        <div class="field"><label for="email">Ton e-mail</label><input id="email" name="email" type="email" required autocomplete="email"></div>
        <button class="v-cta" type="submit">{d.bouton}</button>
        <p class="note">{d.final_rassurance} Voir la <a href="/politique-de-confidentialite/">politique de confidentialité</a>.</p>
      </form>
    </div>
  </div>
</Vente>
