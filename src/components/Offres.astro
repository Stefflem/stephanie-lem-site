---
/**
 * Bloc des trois offres, posé partout où un lecteur chaud passe.
 * Le contenu vit dans src/content/pages/offres.md, modifiable par Stéphanie.
 */
import { getEntry } from 'astro:content';
import { sansLesPauses } from '../offres';
interface Props { titre?: string; sauf?: string; famille?: 'retraite' | 'clarte'; seulement?: string[] }
const { titre = 'Par où commencer', sauf, famille, seulement } = Astro.props;
const page = await getEntry('pages', 'offres');
/* Une offre dont la page est en pause disparaît d'ici toute seule :
   Stéphanie n'a qu'une case à décocher, pas deux endroits à penser. */
/* Sans famille, tout s'affiche (À propos). Avec, seule la famille de la page :
   la coach qui prépare une retraite ne se voit pas proposer un roman. */
const offres = await sansLesPauses((page?.data.offres ?? []).filter((o) => o.href !== sauf && (!famille || o.famille === famille) && (!seulement || seulement.includes(o.href))));
---
{offres.length > 0 && (
  <section class="offres">
    <p class="eyebrow">{titre}</p>
    <div class="offres-grille">
      {offres.map((o) => (
        <article class={o.mise_en_avant ? 'offre en-avant' : 'offre'}>
          {o.prix && <span class="offre-prix">{o.prix}</span>}
          <h3>{o.titre}</h3>
          <p>{o.texte}</p>
          <a class="offre-lien" href={o.href}>{o.bouton}</a>
        </article>
      ))}
    </div>
  </section>
)}
