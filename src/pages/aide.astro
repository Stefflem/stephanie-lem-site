---
/**
 * Mode d'emploi de Stéphanie. Écrit pour elle, au tutoiement (Emmanuel la tutoie),
 * sans jargon.
 * Cette page ne contient PAS le mode d'emploi. Elle contient une porte, et un
 * conteneur vide que public/js/aide.js remplit en appelant /api/aide avec la
 * session ouverte sur /admin/. La fonction vérifie côté serveur que la
 * personne peut modifier le site avant de renvoyer une ligne. Le texte vit
 * dans netlify/lib/aide-contenu.mjs, hors de tout ce qui est servi.
 *
 * En noindex, hors du plan du site, fermée aux robots. Le seul lien qui y
 * mène est dans son espace d'édition.
 */
import Base from '../layouts/Base.astro';
---
<Base
  title="Mode d'emploi de ton site"
  titreExact="Mode d'emploi de ton site | Stellaé Experiences"
  description="Comment modifier ton site toi même."
  noindex={true}
>
  <div id="aide-porte" class="reading aide" hidden>
    <header class="page-head">
      <p class="eyebrow">Page réservée</p>
      <h1>Cette page est pour Stéphanie</h1>
      <p class="head-lead">
        Elle s'ouvre une fois connectée à ton espace.
      </p>
    </header>
    <p><a class="btn" href="/admin/">Ouvrir mon espace</a></p>
    <p class="aide-note">Tu n'es pas Stéphanie ? <a href="/">Retourner sur le site</a>.</p>
  </div>

  <div id="aide-contenu" class="aide-charge" hidden></div>
  <script is:inline src="/js/aide.js"></script>
</Base>
