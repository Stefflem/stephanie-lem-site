---
/**
 * Bandeau de consentement à la mesure d'audience.
 *
 * ⚠️ Toute la logique vit dans `public/js/consentement.js`, pas ici. La
 * politique de sécurité du site interdit les scripts en ligne, et un bandeau
 * écrit en ligne aurait des boutons qui ne répondent pas. Ne jamais remettre
 * de `<script>` ni de `onclick` dans ce fichier.
 */
import { AUDIENCE, CONSENTEMENT_JOURS } from '../site';
const ga = AUDIENCE.outil === 'ga4' ? AUDIENCE.id : null;
---
{ga && (
  <>
    <div id="consentement" role="dialog" aria-label="Mesure d'audience"
         data-ga={ga} data-jours={String(CONSENTEMENT_JOURS)} hidden>
      <div class="cons-in">
        <p>
          Ce site mesure son audience pour comprendre ce qui est lu et améliorer ses pages.
          Rien ne se charge tant que tu n'as pas choisi.
          <a href="/politique-de-confidentialite/">En savoir plus</a>.
        </p>
        <div class="cons-actions">
          <button type="button" class="cons-btn" data-choix="oui">Accepter</button>
          <button type="button" class="cons-btn cons-btn-2" data-choix="non">Refuser</button>
        </div>
      </div>
    </div>
    <script is:inline src="/js/consentement.js" defer></script>
  </>
)}
