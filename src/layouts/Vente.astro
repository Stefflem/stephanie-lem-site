---
/**
 * Gabarit des pages de vente rapatriées de systeme.io.
 * Volontairement sans la navigation du site : une page de vente a un seul chemin.
 * Le logo ramène à l'accueil, le pied de page porte le légal et le contact.
 */
import '../styles/polices.css';
import '../styles/global.css';
import '../styles/vente.css';
import Schema from '../components/Schema.astro';
import { reglagesVente } from '../vente';
const VENTE = await reglagesVente();
import { AUDIENCE, PALETTE, APERCU } from '../site';
import ChoixPalette from '../components/ChoixPalette.astro';
import BandeauApercu from '../components/BandeauApercu.astro';
import { REVUE_PALETTE } from '../revue';

interface Props { title: string; titreExact?: string; description?: string; image?: string; noindex?: boolean; schema?: Record<string, unknown> }
const { title, titreExact, description = '', image = '/images/portrait-accueil.jpg', noindex = false, schema } = Astro.props;
/* Si la page fournit un titre pour Google, il fait foi tel quel : c'est le
   seul moyen de tenir les 50 à 60 caractères. Sinon, comportement d'avant. */
const fullTitle = titreExact || title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="fr" data-variante={PALETTE || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Stellaé Experiences">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="fr_FR">
<meta name="twitter:card" content="summary_large_image">
{REVUE_PALETTE && <script is:inline src="/js/variante.js"></script>}
{AUDIENCE.outil === 'umami' && <script is:inline defer src={AUDIENCE.src} data-website-id={AUDIENCE.siteId}></script>}
{AUDIENCE.outil === 'plausible' && <script is:inline defer src="https://plausible.io/js/script.js" data-domain={AUDIENCE.domaine}></script>}
<Schema data={{
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Stellaé Experiences',
  alternateName: 'Stéphanie Lem', url: Astro.site?.toString(), image: ogImage.toString(),
  founder: { '@type': 'Person', name: 'Stéphanie Lem' }, areaServed: 'FR', inLanguage: 'fr',
  sameAs: ['https://www.instagram.com/stephanie.lem.doula/'],
}} />
{schema && <Schema data={schema} />}
</head>
<body class={REVUE_PALETTE ? "avec-revue" : undefined}>
{APERCU && <BandeauApercu />}
<header class="v-entete">
  <div class="v-entete-in">
    <a href="/" aria-label="Stellaé Experiences, accueil"><img src="/images/logo.png" alt="Stellaé Experiences" width="520" height="242"></a>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="v-pied">
  <div class="v-pied-in">
    <span>© {new Date().getFullYear()} Stellaé Experiences · Stéphanie Lem</span>
    <span>
      <a href="/guideoffert/">Guide offert</a> ·
      <a href="/lesocle/">Le Socle</a> ·
      <a href="/latraversee/">La Traversée</a> ·
      <a href="/deepdrive/">Deep Drive</a> ·
      <a href="/ysaline/">Le roman</a> ·
      <a href="/mentions-legales/">Mentions légales</a> ·
      <a href="/conditions-generales-de-vente/">CGV</a> ·
      <a href="/politique-de-confidentialite/">Confidentialité</a> ·
      <a href={`mailto:${VENTE.contact}`}>{VENTE.contact}</a>
    </span>
  </div>
</footer>
{REVUE_PALETTE && <ChoixPalette />}
</body>
</html>
