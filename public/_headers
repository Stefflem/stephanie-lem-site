# En têtes de sécurité, appliqués par Netlify à chaque réponse.
# Mode forteresse : le site ne charge rien qui ne vienne de son propre domaine.
# Polices auto hébergées, Decap auto hébergé, aucun appel tiers.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

# ⚠️ Si la mesure d'audience est un jour allumée dans src/site.ts, ajouter son
# domaine à script-src ET à connect-src ci dessus, sinon le script sera bloqué.
# Exemple pour Umami auto hébergé : script-src 'self' https://stats.stephanielem.fr

# L'espace de Stéphanie parle à GitHub, il lui faut sa propre règle.
# 'unsafe-eval' est exigé par Decap, qui compile ses widgets à la volée.
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com https://raw.githubusercontent.com https://*.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://api.github.com https://api.netlify.com https://raw.githubusercontent.com https://*.githubusercontent.com; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
