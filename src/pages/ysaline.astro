---
/** La traversée d'Ysaline, son roman. Copy dans src/content/vente/ysaline.md.
 *  ⚠️ Sa page systeme.io était cassée : le corps reprenait Le Socle. Seul le
 *  contenu réellement consacré au roman est repris ici, le reste est à écrire. */
import Vente from '../layouts/Vente.astro';
import VenteCorps from '../components/VenteCorps.astro';
import { getEntry } from 'astro:content';
import { APERCU } from '../site';
import { reglagesVente } from '../vente';
const VENTE = await reglagesVente();
const page = await getEntry('vente', 'ysaline');
if (!page) throw new Error('Contenu ysaline manquant');
const d = page.data;
const schema = {
  '@context': 'https://schema.org', '@type': 'Book',
  name: d.surtitre, alternateName: d.titre, description: d.seo_description,
  author: { '@type': 'Person', name: 'Stéphanie Lem' },
  inLanguage: 'fr', bookFormat: 'https://schema.org/EBook',
  image: d.visuel_ensemble ? `https://www.stephanielem.fr${d.visuel_ensemble}` : undefined,
  url: 'https://www.stephanielem.fr/ysaline/',
  offers: VENTE.ysalinePrix
    ? { '@type': 'Offer', price: VENTE.ysalinePrix.replace(/[^0-9,.]/g, '').replace(',', '.'),
        priceCurrency: 'EUR', availability: 'https://schema.org/InStock',
        url: 'https://www.stephanielem.fr/ysaline/' }
    : undefined,
};
const lien = VENTE.ysalineLienPaiement || (APERCU ? '#commander' : `mailto:${VENTE.contact}?subject=La%20traversee%20d%27Ysaline`);
---
<Vente title={`${d.surtitre} | Stellaé Experiences`} description={d.seo_description} image={d.banniere} titreExact={d.seo_titre || undefined} schema={schema}>
  {d.banniere && <div class="v-banniere"><img src={d.banniere} alt={d.titre} width="1200" height="675" fetchpriority="high"></div>}
  <section class="v-wrap v-hero">
    <p class="v-eyebrow">{d.surtitre}</p>
    <h1>{d.titre}</h1>
    <p class="v-sur">{d.accroche}</p>
    {d.sous_titres.map((s) => <p class="v-sous">{s}</p>)}
    <div class="v-cta-bloc">
      <a class="v-cta" href={lien}>{d.bouton}{VENTE.ysalinePrix ? ` – ${VENTE.ysalinePrix}` : ''}</a>
      <p class="v-rassure">{d.rassurance}</p>
    </div>
  </section>
  <div class="v-wrap">
    <VenteCorps body={page.body ?? ''} />
    <div class="v-prix" id="commander">
      {d.visuel_ensemble && <img class="v-ensemble" src={d.visuel_ensemble} alt="La traversée d'Ysaline, le roman" loading="lazy">}
      {VENTE.ysalinePrix && <p class="v-eyebrow">{VENTE.ysalinePrix}</p>}
      <h2>{d.final_titre}</h2>
      <p>{d.final_sous}</p>
      <div class="v-cta-bloc">
        {VENTE.ysalineLienPaiement
          ? <a class="v-cta" href={VENTE.ysalineLienPaiement}>{d.bouton}</a>
          : <a class="v-cta" href={`mailto:${VENTE.contact}?subject=La%20traversee%20d%27Ysaline`}>Écrire à Stéphanie pour le recevoir</a>}
        <p class="v-rassure">{d.final_rassurance}</p>
      </div>
    </div>
    <section class="v-sec">
      <p>{d.contact_texte} <a href={`mailto:${VENTE.contact}`}>{VENTE.contact}</a></p>
    </section>
  </div>
</Vente>
