---
/**
 * Livraison du Socle après paiement. C'est l'adresse à indiquer à Stripe
 * comme page de retour après un paiement réussi.
 */
import Vente from '../layouts/Vente.astro';
import { VENTE } from '../site';
const f = VENTE.fichiers;
const items = [
  { nom: "Guide « Tenir l'espace »", lien: f.tenirLespace, act: 'Télécharger le PDF' },
  { nom: 'Quick Start 7 jours', lien: f.quickStart, act: 'Télécharger le PDF' },
  { nom: 'Speed hypnose « Peur »', lien: f.hypnosePeur, act: "Télécharger l'audio" },
  { nom: 'Speed hypnose « Ancrage »', lien: f.hypnoseAncrage, act: "Télécharger l'audio" },
  { nom: 'Canal Telegram privé', lien: f.telegram, act: 'Rejoindre le canal' },
];
---
<Vente title="Ton accès au Socle | Stellaé Experiences" noindex={true}>
  <div class="v-acces">
    <p class="v-eyebrow">Merci pour ta confiance</p>
    <h1>Bienvenue dans <em>Le Socle</em></h1>
    <p class="v-sous" style="margin:18px 0 0">Tout est ici. Tu reçois aussi ces accès par e-mail, garde le précieusement, cette page ne se retrouve pas depuis le site.</p>
    <div class="v-acces-liste">
      {items.map((i) => i.lien
        ? <a href={i.lien} target={i.act === 'Rejoindre le canal' ? '_blank' : undefined} rel="noopener"><span class="v-acces-nom">{i.nom}</span><span class="v-acces-act">{i.act}</span></a>
        : <span><span class="v-acces-nom">{i.nom}</span><span class="v-acces-act">Lien à venir</span></span>)}
    </div>
    <p class="note">Un lien ne fonctionne pas ? Écris moi à <a href={`mailto:${VENTE.contact}`}>{VENTE.contact}</a>. Garantie 14 jours, il suffit de demander.</p>
  </div>
</Vente>
