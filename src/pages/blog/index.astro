---
import Offres from '../../components/Offres.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
const tous = (await getCollection('blog')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const publies = tous.filter((p) => !p.data.draft);
const aVenir = tous.filter((p) => p.data.draft);
const intro = marked.parse(`Ici, je partage tout ce qui tourne autour de la création et de l’organisation d’une retraite ou d’un séjour immersif.

J’y développe plus longuement des sujets que je ne peux pas toujours approfondir ailleurs : la construction de l’expérience, le budget, la logistique, le choix du lieu, le rythme, les participants, les imprévus, la vente ou encore les coulisses des projets que j’accompagne.

Tu peux simplement choisir le sujet qui t’intéresse et aller lire l’article.`) as string;
---
<Base title="Le blog" titreExact="Organiser une retraite : conseils et méthode, le blog" description="Les coulisses d’une retraite : par où commencer, choisir le lieu, fixer le prix, combien de participantes, quoi anticiper. Les articles de Stéphanie Lem.">
  <header class="page-head">
    <p class="eyebrow">Le blog</p>
    <h1>Les coulisses d’une <em>retraite</em></h1>
  </header>
  <div class="wrap">
    <div class="lead" set:html={intro} />
    <div class="posts">
      {publies.map((p) => (
        <a class="post" href={`/blog/${p.id}/`}>
          <span class="post-theme">{p.data.theme}</span>
          <span class="post-title">{p.data.title}</span>
          <span class="post-go">Lire l’article</span>
        </a>
      ))}
    </div>

    {aVenir.length > 0 && (
      <section class="a-venir">
        <p class="eyebrow">Prochainement</p>
        <div class="a-venir-grille">
          {aVenir.map((p) => (
            <article class="a-venir-carte">
              {p.data.image && <img src={p.data.image} alt="" loading="lazy" width="1400" height="875">}
              <div class="a-venir-corps">
                <span class="post-theme">{p.data.theme}</span>
                <h3>{p.data.title}</h3>
                <span class="a-venir-etat">En cours d’écriture</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
    <Offres famille="retraite" />
  </div>
</Base>
