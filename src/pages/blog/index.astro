---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
const posts = (await getCollection('blog')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const intro = marked.parse(`Ici, je partage tout ce qui tourne autour de la création et de l’organisation d’une retraite ou d’un séjour immersif.

J’y développe plus longuement des sujets que je ne peux pas toujours approfondir ailleurs : la construction de l’expérience, le budget, la logistique, le choix du lieu, le rythme, les participants, les imprévus, la vente ou encore les coulisses des projets que j’accompagne.

Tu peux simplement choisir le sujet qui t’intéresse et aller lire l’article.`) as string;
---
<Base title="Le blog" description="Les coulisses d’une retraite : expérience, lieu, participants, inscriptions, prix, organisation. Les articles de Stéphanie Lem.">
  <header class="page-head">
    <p class="eyebrow">Le blog</p>
    <h1>Les coulisses d’une <em>retraite</em></h1>
  </header>
  <div class="wrap">
    <div class="lead" set:html={intro} />
    <div class="posts">
      {posts.map((p) => p.data.draft ? (
        <div class="post soon" aria-disabled="true">
          <span class="post-theme">{p.data.theme}</span>
          <span class="post-title">{p.data.title}</span>
          <span class="post-go">Bientôt</span>
        </div>
      ) : (
        <a class="post" href={`/blog/${p.id}/`}>
          <span class="post-theme">{p.data.theme}</span>
          <span class="post-title">{p.data.title}</span>
          <span class="post-go">Lire l’article</span>
        </a>
      ))}
    </div>
  </div>
</Base>
