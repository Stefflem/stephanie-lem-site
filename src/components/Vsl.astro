---
/**
 * Sa vidéo de vente, avec son habillage de lancement.
 *
 * Servie par le site lui même : aucun tiers, aucun cookie, aucun logo. Le
 * même composant sert la page qui suit le guide et la page dédiée vers
 * laquelle le guide renvoie : une seule vidéo, un seul habillage, deux
 * entrées. Le script qui compte la lecture et le clic vit dans
 * public/js/vsl.js, la politique interdit les scripts en ligne.
 */
interface Props { titre?: string; sous?: string }
const { titre = "Et si ta prochaine étape<br>se jouait <em>en présence</em> ?", sous = '5 minutes avec Stéphanie' } = Astro.props;
---
<div class="v-video">
  <video id="vsl" playsinline preload="metadata" poster="/video/declic-immersif-poster.jpg">
    <source src="/video/declic-immersif.mp4" type="video/mp4">
    Ton navigateur ne lit pas cette vidéo.
  </video>
  <button type="button" class="v-lancer" id="lancer" aria-label="Lire la vidéo">
    <span class="v-lancer-titre" set:html={titre}></span>
    <span class="v-lancer-rond"><span class="v-lancer-tri"></span></span>
    <span class="v-lancer-sous">{sous}</span>
  </button>
</div>
